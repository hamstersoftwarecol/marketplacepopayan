{
  "name": "marketplace-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply marketplace --local",
    "deploy": "wrangler deploy --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply marketplace-popayan-staging --env staging --remote"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
